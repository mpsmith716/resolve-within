{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "workbox-config.js"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "dist",
    "utils/polyfills",
    "backend/tests",
    "backend/node_modules",
    "**/*.test.ts",
    "lib/authHeaders.test.ts"
  ]
}
