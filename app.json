{
  "expo": {
    "name": "Resolve Within",
    "slug": "resolve-within",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-nkg.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/app-icon-nkg.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cypherwavestudios.resolvewithin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Resolve Within may send gentle reminders to help you pause, breathe, or check in during the day."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-nkg.png",
        "backgroundColor": "#000000"
      },
      "package": "com.cypherwavestudios.resolvewithin",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/final_quest_240x240.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon-nkg.png",
          "color": "#FFD700",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Resolve Within",
          "iosDisplayInForeground": true
        }
      ]
    ],
    "scheme": "resolvewithin",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "backendUrl": "https://resolve-within-backend.onrender.com",
      "eas": {
        "projectId": "1ab9b6ed-f00e-494c-813d-4b9d0d1e998f"
      }
    },
    "owner": "mpsmith716"
  }
}
